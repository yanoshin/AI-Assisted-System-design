@startuml EC-Data-Model
title ECサイト データモデル（クラス図）

hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ==== 列挙 ====
enum "注文ステータス (OrderStatus)" as OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum "支払方法 (PaymentMethod)" as PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CONVENIENCE_STORE
  COD
}

enum "支払ステータス (PaymentStatus)" as PaymentStatus {
  UNPAID
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum "配送ステータス (ShipmentStatus)" as ShipmentStatus {
  PREPARING
  SHIPPED
  IN_TRANSIT
  DELIVERED
}

' ==== エンティティ ====
class "会員 (Customer)" as Customer {
  +id: Long <<PK, 会員ID>>
  +name: String <<氏名>>
  +email: String <<メールアドレス>>
  +passwordHash: String <<パスワードハッシュ>>
  +phone: String <<電話番号>>
  +createdAt: DateTime <<登録日時>>
}

class "配送先住所 (Address)" as Address {
  +id: Long <<PK, 住所ID>>
  +customerId: Long <<FK, 会員ID>>
  +postalCode: String <<郵便番号>>
  +prefecture: String <<都道府県>>
  +city: String <<市区町村>>
  +line1: String <<番地>>
  +line2: String <<建物名>>
  +recipientName: String <<宛名>>
}

class "カテゴリ (Category)" as Category {
  +id: Long <<PK, カテゴリID>>
  +parentId: Long <<FK nullable, 親カテゴリID>>
  +name: String <<名称>>
}

class "商品 (Product)" as Product {
  +id: Long <<PK, 商品ID>>
  +categoryId: Long <<FK, カテゴリID>>
  +name: String <<商品名>>
  +description: String <<説明>>
  +price: Decimal <<価格>>
  +stock: Integer <<在庫数>>
  +sku: String <<SKU>>
  +status: String <<状態>>
  +createdAt: DateTime <<登録日時>>
}

class "カート (Cart)" as Cart {
  +id: Long <<PK, カートID>>
  +customerId: Long <<FK, 会員ID>>
  +createdAt: DateTime <<作成日時>>
}

class "カート明細 (CartItem)" as CartItem {
  +id: Long <<PK, 明細ID>>
  +cartId: Long <<FK, カートID>>
  +productId: Long <<FK, 商品ID>>
  +quantity: Integer <<数量>>
}

class "注文 (Order)" as Order {
  +id: Long <<PK, 注文ID>>
  +customerId: Long <<FK, 会員ID>>
  +shippingAddressId: Long <<FK, 配送先住所ID>>
  +status: OrderStatus <<注文ステータス>>
  +totalAmount: Decimal <<合計金額>>
  +orderedAt: DateTime <<注文日時>>
}

class "注文明細 (OrderItem)" as OrderItem {
  +id: Long <<PK, 明細ID>>
  +orderId: Long <<FK, 注文ID>>
  +productId: Long <<FK, 商品ID>>
  +quantity: Integer <<数量>>
  +unitPrice: Decimal <<単価>>
}

class "支払 (Payment)" as Payment {
  +id: Long <<PK, 支払ID>>
  +orderId: Long <<FK, 注文ID>>
  +method: PaymentMethod <<支払方法>>
  +amount: Decimal <<金額>>
  +status: PaymentStatus <<支払ステータス>>
  +paidAt: DateTime <<支払日時>>
}

class "配送 (Shipment)" as Shipment {
  +id: Long <<PK, 配送ID>>
  +orderId: Long <<FK, 注文ID>>
  +carrier: String <<配送業者>>
  +trackingNo: String <<追跡番号>>
  +status: ShipmentStatus <<配送ステータス>>
  +shippedAt: DateTime <<発送日時>>
  +deliveredAt: DateTime <<配達日時>>
}

class "レビュー (Review)" as Review {
  +id: Long <<PK, レビューID>>
  +customerId: Long <<FK, 会員ID>>
  +productId: Long <<FK, 商品ID>>
  +rating: Integer <<評価>>
  +comment: String <<コメント>>
  +createdAt: DateTime <<投稿日時>>
}

' ==== 関連 ====
Customer "1" -- "0..*" Address
Customer "1" -- "0..1" Cart
Customer "1" -- "0..*" Order
Customer "1" -- "0..*" Review

Category "0..1" -- "0..*" Category : parent / children
Category "1" -- "0..*" Product

Cart "1" *-- "0..*" CartItem
Product "1" -- "0..*" CartItem

Order "1" *-- "1..*" OrderItem
Product "1" -- "0..*" OrderItem
Order "1" -- "1" Payment
Order "1" -- "0..*" Shipment
Address "1" -- "0..*" Order : shipping

Product "1" -- "0..*" Review

@enduml
